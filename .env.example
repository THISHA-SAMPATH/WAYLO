# ==============================================================================
# WAYLO: Shared-Autonomy Spatial Mobility Copilot
# Environment Configuration Template
# ==============================================================================

# Nebius AI Cloud / Token Factory Credentials
# Obtain API key from https://tokenfactory.nebius.com or https://studio.nebius.ai
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-ultra
# Alternative supported models:
# NEBIUS_MODEL=nvidia/cosmos-nemotron-34b
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Tavily Search API (for real-time accessibility & spatial standards retrieval)
# Obtain API key from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# WAYLO FastAPI Server Configuration
WAYLO_HOST=0.0.0.0
WAYLO_PORT=8000
WAYLO_DEBUG=true

# Shared Autonomy Safety & Kinematic Defaults
MAX_VELOCITY_MPS=1.5
CRITICAL_STOP_DISTANCE_M=0.45
NOMINAL_DOORWAY_CLEARANCE_M=0.81
WHEELBASE_METERS=0.60
WHEEL_RADIUS_METERS=0.16
